# Tetra Ops — env template
# Copy to .env.local and fill in values.

# Supabase (from Supabase project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive OAuth (from Google Cloud Console → Credentials → Web client)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/auth/google-drive/callback

# App identity
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tetra Ops

# Cron auth (generate with: openssl rand -base64 32)
CRON_SECRET=

# Web Push VAPID keys (generate once with: node scripts/generate-vapid-keys.mjs)
# Public key is sent to client to subscribe; private signs the push payload.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=tetraphotobooth@gmail.com
