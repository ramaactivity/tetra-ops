# Tetra Ops — env template
# Copy to .env.local and fill in values.

# Supabase (from Supabase project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive OAuth (from Google Cloud Console → Credentials → Web client)
# Run: node scripts/get-drive-refresh-token.mjs to obtain refresh token.
# Parent folder ID = ID dari folder "Tetra Ops Events" yang kamu buat manual di Drive
# (lihat di URL Drive: /folders/<ID>).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# App identity
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tetra Ops

# Cron auth (generate with: openssl rand -base64 32)
CRON_SECRET=

# WA Bot API auth — Bearer token untuk GET /api/availability (generate with:
# openssl rand -base64 32). Kalau kosong di production endpoint menolak (401);
# kosong di lokal = boleh (dev). Lihat WHATSAPP_BOT_AVAILABILITY_HANDOVER.md.
AVAILABILITY_API_TOKEN=

# Web Push VAPID keys (generate once with: node scripts/generate-vapid-keys.mjs)
# Public key is sent to client to subscribe; private signs the push payload.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=tetraphotobooth@gmail.com

# Telegram bot grup owner — reminder kesiapan event (BotFather token).
# TELEGRAM_WEBHOOK_SECRET: openssl rand -hex 32; dipakai verifikasi header
# X-Telegram-Bot-Api-Secret-Token di /api/telegram/webhook. Setelah set env,
# jalankan: node --env-file=.env.local scripts/telegram-setup.mjs
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── AI "Tanya Tetra" ─────────────────────────────────────────────────────
# Kunci Gemini dari https://aistudio.google.com/apikey (tier GRATIS, tidak
# perlu kartu kredit). Dipakai halaman /tanya dan perintah /tanya di bot
# Telegram. Kalau kosong, fitur tampil sebagai "belum aktif" — sisa aplikasi
# tetap jalan normal.
GEMINI_API_KEY=
# Opsional — daftar model dipisah koma, urut prioritas (pintar → hemat).
# Default: gemini-2.5-flash,gemini-flash-lite-latest
#
# KENAPA BERANTAI: kuota tier gratis dihitung PER MODEL PER HARI
# (gemini-2.5-flash cuma 20 request/hari). Karena tiap model punya jatah
# sendiri, jatuh ke model berikutnya saat kena 429 melipatgandakan kapasitas
# harian tanpa biaya. Jangan masukkan gemini-2.0-flash / gemini-2.5-pro:
# keduanya berkuota 0 di tier gratis, jadi hanya membuang satu request.
GEMINI_MODELS=
